# --- Postgres: base de metadata de Airflow (mismo servidor, DB separada) ---
AIRFLOW_META_DB=airflow_meta

# --- Airflow ---
AIRFLOW_UID=50000
# Vacío = Airflow corre sin cifrar passwords de conexiones (OK para este challenge local).
# Para generar una key real: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Generar con: python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW__WEBSERVER__SECRET_KEY=changeme_generate_a_secret_key
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=changeme
